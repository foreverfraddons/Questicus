package-as: Questicus

move-folders:
  Questicus/Questicus: Questicus
  # the language packs: addons of their own in the same download (load-on-demand; CurseForge allows no
  # extra files per version)
  Questicus/Locales/Questicus_deDE: Questicus_deDE
  Questicus/Locales/Questicus_frFR: Questicus_frFR
  Questicus/Locales/Questicus_esES: Questicus_esES
  Questicus/Locales/Questicus_esMX: Questicus_esMX
  Questicus/Locales/Questicus_itIT: Questicus_itIT
  Questicus/Locales/Questicus_ptBR: Questicus_ptBR
  Questicus/Locales/Questicus_ruRU: Questicus_ruRU
  Questicus/Locales/Questicus_koKR: Questicus_koKR
  Questicus/Locales/Questicus_zhCN: Questicus_zhCN
  Questicus/Locales/Questicus_zhTW: Questicus_zhTW

# The quest database ships as its own CurseForge project (ForeverDB). The map art (Questicus Maps,
# from OpenMap) is copied into Questicus/Media/Textures by the release workflow before packaging.
# patch notes for the CurseForge file: written by the release workflow from Questicus/Changelog.lua
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

required-dependencies:
  - forever-db

ignore:
  - tools
  - upstream.json
  - README.md
  - NOTICE.md
  - CHANGELOG.md
  - .github
  - Questicus/dev
